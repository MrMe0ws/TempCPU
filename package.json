{
  "name": "tempcpu",
  "productName": "TempCPU",
  "version": "1.1.0",
  "description": "Виджет температуры процессора и видеокарты для рабочего стола",
  "author": "Meows",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/make-icon.js && electron-builder --win"
  },
  "build": {
    "appId": "com.tempcpu.app",
    "productName": "TempCPU",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/setup-lhm.ps1",
        "to": "setup-lhm.ps1"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TempCPU"
    }
  },
  "dependencies": {
    "koffi": "^3.3.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
